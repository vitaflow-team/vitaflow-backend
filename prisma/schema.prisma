// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum ProductType {
  USER
  NUTRITIONIST
  PHYSICAL_EDUCATOR
}

model Users {
  id        String    @id @default(uuid(7))
  name      String
  email     String
  password  String
  avatar    String?
  active    Boolean   @default(false)
  phone     String?
  birthDate DateTime?
  product   Product?  @relation(fields: [productId], references: [id])
  productId String?

  // Timestamp doubles as proof-of-consent (LGPD art. 8º requires the
  // controller to be able to demonstrate consent was given) and as the
  // "did they consent" flag — null means no consent on record.
  termsAcceptedAt     DateTime?
  healthDataConsentAt DateTime?

  // Mirrors Stripe's own state so the app can answer "is this user
  // subscribed" without calling Stripe on every request. Stripe (via
  // webhooks) is still the source of truth — these are a cache of it.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  subscriptionCancelAt DateTime?

  // End of the current billing period, so the app can answer "when does
  // this renew?" without calling Stripe. Null means unknown — either no
  // subscription, or a subscriber whose next Stripe event hasn't filled
  // it in yet.
  subscriptionCurrentPeriodEnd DateTime?

  // Marks Vita Flow internal staff, checked by BackofficeGuard. Set
  // explicitly, never inferred from email domain or product type.
  isBackoffice Boolean @default(false)

  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  usersTokens                 UsersToken[]
  userAddresses               UserAddress?
  clients                     Client[]
  oAuthIdentity               OAuthIdentity?
  measurementRecords          MeasurementRecord[]
  submittedExercises          Exercise[]               @relation("ExerciseSubmittedBy")
  reviewedExercises           Exercise[]               @relation("ExerciseReviewedBy")
  fitnessProfile              FitnessProfile?
  workouts                    Workout[]
  meals                       Meal[]
  waterLogs                   WaterLog[]
  featureConsents             FeatureConsent[]
  progressPhotos              ProgressPhoto[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  professionalProfile         ProfessionalProfile?
  connectionRequestsSent      ConnectionRequest[]      @relation("ConnectionRequestFromUser")
  connectionRequestsReceived  ConnectionRequest[]      @relation("ConnectionRequestToProfessional")
  conversationsAsUser         Conversation[]           @relation("ConversationAsUser")
  conversationsAsProfessional Conversation[]           @relation("ConversationAsProfessional")
  sentMessages                Message[]                @relation("MessageSender")
  availabilityWindows         AvailabilityWindow[]
  slotsAsProfessional         Slot[]                   @relation("SlotProfessional")
  slotsAsUser                 Slot[]                   @relation("SlotUser")

  @@unique([email])
}

model MeasurementRecord {
  id         String   @id @default(uuid(7))
  user       Users    @relation(fields: [userId], references: [id])
  userId     String
  weightKg   Float
  heightCm   Float
  waistCm    Float?
  hipCm      Float?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, recordedAt])
}

model OAuthIdentity {
  id                String   @id @default(uuid(7))
  provider          String
  providerAccountId String
  user              Users    @relation(fields: [userId], references: [id])
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([provider, userId])
}

model Client {
  id        String    @id @default(uuid(7))
  name      String
  phone     String
  email     String
  userId    String?   @map("user_id")
  birthDate DateTime?

  professional   Users  @relation(fields: [professionalId], references: [id])
  professionalId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments      PhysicalAssessment[]
  educatorWorkouts EducatorWorkout[]

  @@unique([email, professionalId])
  @@index([email])
}

enum TokenType {
  ACTIVATION
  RECOVERY
}

// The value sent to the user is never stored: only its hash is, so a
// database read discloses no usable link. `id` is just the primary key.
model UsersToken {
  id        String    @id @default(uuid(7))
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  user      Users     @relation(fields: [userID], references: [id])
  userID    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userID, type])
}

model UserAddress {
  id           String  @id @default(uuid(7))
  addressLine1 String?
  addressLine2 String?
  district     String?
  city         String?
  region       String?
  postalCode   String?

  user   Users  @relation(fields: [userId], references: [id])
  userId String @unique
}

model ProductGroup {
  id        String    @id @default(uuid(7))
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String        @id @default(uuid(7))
  name         String
  price        Float
  group        ProductGroup  @relation(fields: [groupId], references: [id])
  groupId      String
  type         ProductType   @default(USER)
  stripeId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  productInfos ProductInfo[]
  users        Users[]
}

model ProductInfo {
  id          String   @id @default(uuid(7))
  description String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ExerciseEquipment {
  GYM
  HOME_BASIC
  BODYWEIGHT
}

enum ExerciseContraindication {
  SHOULDER
  KNEE
  SPINE
  WRIST
  HIP
  ANKLE
  CARDIAC
}

enum ExerciseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Exercise {
  id                       String                     @id @default(uuid(7))
  name                     String
  description              String
  muscleGroup              String
  primaryMuscles           String[]
  secondaryMuscles         String[]
  equipment                ExerciseEquipment
  contraindications        ExerciseContraindication[]
  difficulty               String?
  imageUrl                 String?
  videoUrl                 String?
  status                   ExerciseStatus             @default(APPROVED)
  // Per-record source/license metadata for imported rows (ADR-001); null
  // for exercises authored in-house.
  sourceAttribution        String?
  sourceLicense            String?
  submittedById            String?
  submittedBy              Users?                     @relation("ExerciseSubmittedBy", fields: [submittedById], references: [id])
  reviewedById             String?
  reviewedBy               Users?                     @relation("ExerciseReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason          String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  workoutExercises         WorkoutExercise[]
  educatorWorkoutExercises EducatorWorkoutExercise[]

  @@index([status])
  @@index([equipment])
}

enum Sex {
  MALE
  FEMALE
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  CONDITIONING
  MAINTENANCE
}

// Shared with the Food Diary feature (ADR-006 of ai-workout-generator):
// both features read/write the same row per user. All fields are
// nullable since a user may have answered only some profile questions.
model FitnessProfile {
  id           String                     @id @default(uuid(7))
  userId       String                     @unique
  user         Users                      @relation(fields: [userId], references: [id])
  sex          Sex?
  restrictions ExerciseContraindication[]
  equipment    ExerciseEquipment?
  goal         FitnessGoal?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model Workout {
  id          String       @id @default(uuid(7))
  userId      String
  user        Users        @relation(fields: [userId], references: [id])
  goal        FitnessGoal
  daysPerWeek Int
  explanation String
  days        WorkoutDay[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model WorkoutDay {
  id        String            @id @default(uuid(7))
  workoutId String
  workout   Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1 (Mon) .. 7 (Sun)
  exercises WorkoutExercise[]

  @@unique([workoutId, dayOfWeek])
}

model WorkoutExercise {
  id           String     @id @default(uuid(7))
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  // Nullable + SetNull (not the usual required+RESTRICT): the Exercise
  // Library backoffice can delete an exercise at any time with no
  // awareness of this feature, and a WorkoutExercise must survive that as
  // an "unavailable" row rather than blocking the delete or vanishing
  // (UT-019).
  exerciseId   String?
  exercise     Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets         Int
  reps         Int
  order        Int

  @@index([workoutDayId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id          String   @id @default(uuid(7))
  userId      String
  user        Users    @relation(fields: [userId], references: [id])
  mealType    MealType
  description String
  calories    Int
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, loggedAt])
}

model WaterLog {
  id        String   @id @default(uuid(7))
  userId    String
  user      Users    @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

enum ConsentFeature {
  PROGRESS_PHOTOS
  PHYSICAL_ASSESSMENT_RECORDING
}

// Generic, reusable LGPD consent gate (ADR-006): the first feature in the
// product to actually enforce a consent flag rather than only record one
// (see `Users.healthDataConsentAt`, never checked anywhere today). A future
// feature needing the same pattern adds an enum value, not new schema.
model FeatureConsent {
  id          String         @id @default(uuid(7))
  userId      String
  user        Users          @relation(fields: [userId], references: [id])
  feature     ConsentFeature
  consentedAt DateTime       @default(now())

  @@unique([userId, feature])
}

enum PhotoAngle {
  FRONT
  SIDE
  BACK
}

// `storageFilename` is the GCS object key only — never a public bucket URL
// (ADR-001). Every read regenerates a fresh signed URL via
// `UploadService.getSignedUrl()`; nothing here is ever directly servable.
model ProgressPhoto {
  id              String     @id @default(uuid(7))
  userId          String
  user            Users      @relation(fields: [userId], references: [id])
  angle           PhotoAngle
  storageFilename String
  takenAt         DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, angle, takenAt])
}

enum NotificationCategory {
  WORKOUT_REMINDER
  CONSULTATION_REMINDER
  MESSAGES
  BILLING
  PRODUCT_NEWS
  CONNECTION_REQUEST
  WORKOUT_PLAN
}

// A missing `NotificationPreference` row for a (userId, category) pair is
// never backfilled — it is treated as that category's documented default
// (everything `true` except PRODUCT_NEWS) by the service layer, so a new
// category never needs a migration to seed existing users (ADR-003).
model Notification {
  id        String               @id @default(uuid(7))
  userId    String
  user      Users                @relation(fields: [userId], references: [id])
  category  NotificationCategory
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
}

model NotificationPreference {
  id       String               @id @default(uuid(7))
  userId   String
  user     Users                @relation(fields: [userId], references: [id])
  category NotificationCategory
  enabled  Boolean

  @@unique([userId, category])
}

// Public profile content for a NUTRITIONIST/PHYSICAL_EDUCATOR account
// (ADR-004 of professional-discovery). Created lazily on first edit, not
// eagerly for every professional account — a professional who never edited
// their profile still has no row here and still appears in search with
// null fields (US-001.EC-2, UT-003/UT-006).
model ProfessionalProfile {
  id            String   @id @default(uuid(7))
  userId        String   @unique
  user          Users    @relation(fields: [userId], references: [id])
  bio           String?
  specialty     String?
  priceFrom     Decimal?
  attendsOnline Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// No DB-level uniqueness on (userId, professionalId, status): a plain
// composite unique would reject a second DECLINED row for the same pair,
// breaking "a past decline never blocks a future request" (US-004.EC-3,
// UT-010), since a user can be declined more than once across repeated
// request cycles. The "only one PENDING per pair" rule is enforced at the
// service layer instead (`requestConnection`'s existence check), per the
// TechSpec's own Known Risks — ADR-004's `@@unique` snippet is illustrative
// only, as its own inline comment notes ("see Implementation Design").
model ConnectionRequest {
  id             String                  @id @default(uuid(7))
  userId         String
  user           Users                   @relation("ConnectionRequestFromUser", fields: [userId], references: [id])
  professionalId String
  professional   Users                   @relation("ConnectionRequestToProfessional", fields: [professionalId], references: [id])
  status         ConnectionRequestStatus @default(PENDING)
  createdAt      DateTime                @default(now())
  decidedAt      DateTime?

  @@index([userId, professionalId, status])
}

// Identified by the (user, professional) pair, created implicitly on first
// send — no separate "start conversation" action (TechSpec Key Decisions).
// `reportedAt` is a single lightweight flag for backoffice review (ADR-003
// of this feature: never a structured moderation pipeline).
model Conversation {
  id             String    @id @default(uuid(7))
  userId         String
  user           Users     @relation("ConversationAsUser", fields: [userId], references: [id])
  professionalId String
  professional   Users     @relation("ConversationAsProfessional", fields: [professionalId], references: [id])
  messages       Message[]
  reportedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, professionalId])
}

model Message {
  id             String       @id @default(uuid(7))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         Users        @relation("MessageSender", fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

enum SessionType {
  PRESENCIAL
  ONLINE
}

enum SlotStatus {
  OPEN
  BOOKED
  CANCELED
}

// A professional's recurring weekly availability (US-001). Expanded into
// individual Slot rows by the generation routine — this model is never
// queried directly for booking, only Slot is.
model AvailabilityWindow {
  id                     String   @id @default(uuid(7))
  professionalId         String
  professional           Users    @relation(fields: [professionalId], references: [id])
  dayOfWeek              Int // 1 (Mon) .. 7 (Sun), ISO 8601
  startMinute            Int // minutes from midnight, BRT (UTC-3, fixed offset — TechSpec Key Decisions)
  endMinute              Int
  sessionDurationMinutes Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// An individual bookable instance generated from an AvailabilityWindow.
// `@@unique([professionalId, startAt])` is the structural double-booking
// guard (ADR-002): generation never creates two rows at the same
// professional+time, and booking only ever updates an existing OPEN row —
// it never inserts a second row that could collide.
model Slot {
  id                   String       @id @default(uuid(7))
  professionalId       String
  professional         Users        @relation("SlotProfessional", fields: [professionalId], references: [id])
  availabilityWindowId String?
  startAt              DateTime // UTC
  endAt                DateTime
  status               SlotStatus   @default(OPEN)
  type                 SessionType?
  onlineLink           String?
  userId               String?
  user                 Users?       @relation("SlotUser", fields: [userId], references: [id])
  reminderSentAt       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([professionalId, startAt])
  @@index([status, startAt])
}

// A physical educator's assessment of one of their students (Client). It is
// attached to the student record, never to a user, so it exists before the
// student has an account and is removed with the record (cascade).
model PhysicalAssessment {
  id               String   @id @default(uuid(7))
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assessedOn       DateTime @db.Date
  weightKg         Float
  heightCm         Float
  bodyFatPercent   Float?
  restingHeartRate Int?
  flexibilityCm    Float?
  armCm            Float?
  chestCm          Float?
  waistCm          Float?
  abdomenCm        Float?
  hipCm            Float?
  thighCm          Float?
  calfCm           Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clientId, assessedOn])
}

// Workouts an educator builds for a student record (E2). They live in their
// own tables, attached to the record, so they exist without an account and go
// away with the student (cascade). The AI workout tables are untouched.
enum EducatorWorkoutStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EducatorExerciseSource {
  LIBRARY
  FREE
}

// One ACTIVE workout per student record is also guaranteed by a partial unique
// index that the schema language cannot declare: see the add_educator_workouts
// migration (EducatorWorkout_one_active_per_client).
model EducatorWorkout {
  id                 String                   @id @default(uuid(7))
  clientId           String
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title              String
  weeklyFrequency    Int?
  status             EducatorWorkoutStatus    @default(DRAFT)
  // Start of the 30-minute window that groups edit notifications.
  lastEditNotifiedAt DateTime?
  sessions           EducatorWorkoutSession[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([clientId, status])
}

model EducatorWorkoutSession {
  id        String                    @id @default(uuid(7))
  workoutId String
  workout   EducatorWorkout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  exercises EducatorWorkoutExercise[]

  @@index([workoutId])
}

model EducatorWorkoutExercise {
  id          String                 @id @default(uuid(7))
  sessionId   String
  session     EducatorWorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position    Int
  source      EducatorExerciseSource
  exerciseId  String?
  exercise    Exercise?              @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  name        String
  muscleGroup String
  equipment   ExerciseEquipment?
  sets        Int
  reps        String
  load        String?
  videoUrl    String?

  @@index([sessionId])
}
