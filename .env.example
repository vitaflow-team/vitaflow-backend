# Required in every environment — the backend refuses to start if any is
# missing, and names the variable.
# JWT_SECRET must be at least 32 characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://user:password@localhost:5432/vitaflow
APPLICATION_SECRET=replace-with-a-strong-application-secret
# Stripe secret key (same account as the frontend). Used read-only to verify
# subscription claims before the backend stores a paid plan.
STRIPE_API_KEY=sk_test_replace-with-your-stripe-secret-key

# Frontend base URL: used in e-mail links and as the allowed CORS origin.
APP_URL=http://localhost:3000

# Google Cloud Storage bucket for avatars.
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCP_BUCKET=

# SMTP account for activation and password-recovery e-mails.
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=

# Google sign-in is enabled only when both variables are set.
# Leave both unset to disable Google sign-in intentionally. Setting only one
# prevents the backend from starting and names the missing variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
PORT=3333
# `production` hides Swagger (/swagger/api) and trusts one proxy hop.
NODE_ENV=development
# Extra browser origins allowed by CORS besides APP_URL, comma-separated.
CORS_ALLOWED_ORIGINS=
# Reverse-proxy hops in front of the app, used to read the client IP from
# X-Forwarded-For. Defaults to 1 in production and 0 elsewhere.
TRUST_PROXY_HOPS=
